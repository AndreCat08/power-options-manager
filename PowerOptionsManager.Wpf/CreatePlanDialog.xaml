<Window x:Class="PowerOptionsManager.CreatePlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PowerOptionsManager.ViewModels"
        xmlns:loc="clr-namespace:PowerOptionsManager.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CreatePlanDialogViewModel}"
        Title="{loc:Tr Create_Title}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Tr Create_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Label Content="{loc:Tr Create_Name}" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{x:Static vm:CreatePlanDialogViewModel.MaxNameLength}"
                 AutomationProperties.Name="{loc:Tr Create_NameA11y}" Margin="0,0,0,16" />

        <Label Content="{loc:Tr Create_Base}" Target="{Binding ElementName=BaseBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="BaseBox" ItemsSource="{Binding BasePlans}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedBasePlan}"
                  AutomationProperties.Name="{loc:Tr Create_BaseA11y}" Margin="0,0,0,8" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Tr Btn_OK}" MinWidth="96" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="{loc:Tr Btn_Cancel}" MinWidth="96" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
